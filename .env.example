# Synthetic, non-secret local defaults. Copy to .env (which is gitignored).
DATABASE_URL=postgresql+psycopg://postgres:mandit@localhost:5432/mandit
TEST_DATABASE_URL=postgresql+psycopg://postgres:mandit@localhost:5432/mandit_test

# Web safety scanner. RDAP (domain age) needs no key; the other lookups run only when a key is set.
MANDIT_PROFILE=local
MANDIT_LIVE_LOOKUPS=on
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
# Optional: your own merchant registry for local testing.
MANDIT_REGISTRY_FILE=
